{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": ".",
    "outDir": "./dist",

    "lib": ["ES2022"],
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,

    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": false,
    },
  "include": ["src/**/*", "server.ts"]
}
